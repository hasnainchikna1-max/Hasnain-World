<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Hasnain World</title>
  <style>
    /* Basic reset */
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{height:100%}
    body{
      background: radial-gradient(ellipse at center, #060606 0%, #000000 70%);
      color:#fff;
      font-family: "Poppins", system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
      -webkit-font-smoothing:antialiased;
      display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:40px 20px;
    }

    /* Header / site name */
    header{
      width:100%;max-width:1100px;display:flex;align-items:center;justify-content:space-between;margin-bottom:36px;
    }
    .brand{
      display:flex;align-items:center;gap:16px;
    }
    .logo{
      width:64px;height:64px;border-radius:12px;background:linear-gradient(135deg,#ffd400,#ffea00);display:flex;align-items:center;justify-content:center;color:#111;font-weight:800;font-size:18px;box-shadow:0 6px 20px rgba(0,0,0,.6);
      transform:rotate(-8deg);
    }
    h1{font-size:22px;letter-spacing:0.6px}
    .subtitle{font-size:13px;opacity:.75}

    /* File area */
    .desk{
      width:100%;max-width:1100px;display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:28px;align-items:start;
    }

    /* Folder card */
    .folder{
      background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
      border:1px solid rgba(255,255,255,0.04);
      padding:22px;border-radius:14px;position:relative;cursor:pointer;overflow:visible;min-height:160px;transition:transform .36s cubic-bezier(.2,.9,.2,1), box-shadow .36s;
      display:flex;flex-direction:column;gap:12px;align-items:flex-start;justify-content:center;
    }
    .folder:hover{transform:translateY(-8px);box-shadow:0 18px 40px rgba(0,0,0,.6)}

    .folder .icon{
      width:64px;height:48px;border-radius:6px;background:#ffe66d;display:flex;align-items:center;justify-content:center;color:#111;font-weight:700;box-shadow:0 6px 18px rgba(0,0,0,.45);
      transform-origin:center;transition:transform .36s;
    }
    .folder:hover .icon{transform:translateY(-6px) rotate(-6deg) scale(1.02)}

    .fname{color:#ffd84d;font-weight:700;letter-spacing:0.4px}
    .fmeta{font-size:12px;opacity:.7}

    /* Animated open overlay */
    .overlay{
      position:fixed;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.6),rgba(0,0,0,.85));display:none;align-items:center;justify-content:center;z-index:1200;padding:24px;
    }
    .overlay.show{display:flex}
    .modal{
      width:min(920px,96%);background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));border-radius:16px;padding:30px;border:1px solid rgba(255,255,255,0.06);box-shadow:0 30px 80px rgba(0,0,0,.7);transform:translateY(18px) scale(.98);opacity:0;transition:transform .45s cubic-bezier(.2,.9,.2,1),opacity .45s;backdrop-filter: blur(6px);
    }
    .overlay.show .modal{transform:translateY(0) scale(1);opacity:1}

    .modal-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}
    .modal-title{display:flex;align-items:center;gap:12px}
    .modal-title .micon{width:56px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:800}
    .modal-body{font-size:18px;line-height:1.6}

    .close-btn{background:transparent;border:0;color:#fff;font-size:20px;cursor:pointer;opacity:.8}

    /* Different folder-specific accent styles */
    .accent-old .micon{background:linear-gradient(135deg,#ffd400,#ff8a00);color:#111}
    .accent-now .micon{background:linear-gradient(135deg,#00d2ff,#0077ff);color:#031028}
    .accent-future .micon{background:linear-gradient(135deg,#8affc1,#00c853);color:#05260f}

    /* Typing / reveal animation for the message */
    .vibe{
      font-weight:700;font-size:20px;margin-top:12px;display:inline-block;overflow:hidden;border-right:3px solid rgba(255,255,255,.12);white-space:nowrap;animation:typing 2.4s steps(26,end), blink .8s step-end infinite alternate;max-width:100%;
    }
    @keyframes typing{from{width:0}to{width:100%}}
    @keyframes blink{50%{border-color:transparent}} 

    /* Subtle background animation (black color theme) */
    .bg-anim{position:fixed;right:-150px;bottom:-150px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle at 30% 30%, rgba(255,255,255,0.03), rgba(255,255,255,0));filter:blur(40px);pointer-events:none;mix-blend-mode:overlay}

    /* Small responsive tweaks */
    @media (max-width:640px){header{flex-direction:column;gap:10px;align-items:flex-start}.logo{width:52px;height:52px}.modal{padding:20px}.vibe{font-size:18px}}
  </style>
</head>
<body>
  <div class="bg-anim" aria-hidden></div>
  <header>
    <div class="brand">
      <div class="logo">HW</div>
      <div>
        <h1>Hasnain World</h1>
        <div class="subtitle">A small animated homepage — black theme • yellow folders</div>
      </div>
    </div>
    <div style="opacity:.9;font-size:13px">Click a folder to open • smooth animations</div>
  </header>

  <main class="desk" role="list">
    <article class="folder" role="listitem" tabindex="0" data-key="old" aria-label="Hasnain's Old folder">
      <div style="display:flex;align-items:center;gap:14px;width:100%">
        <div class="icon">📁</div>
        <div style="flex:1">
          <div class="fname">hasnain,s old</div>
          <div class="fmeta">open to reveal a vibe — animation: warm slide</div>
        </div>
      </div>
    </article>

    <article class="folder" role="listitem" tabindex="0" data-key="now" aria-label="Hasnain's Now folder">
      <div style="display:flex;align-items:center;gap:14px;width:100%">
        <div class="icon">📁</div>
        <div style="flex:1">
          <div class="fname">hasnain,s now</div>
          <div class="fmeta">open to reveal a vibe — animation: cool wave</div>
        </div>
      </div>
    </article>

    <article class="folder" role="listitem" tabindex="0" data-key="future" aria-label="Hasnain's Future folder">
      <div style="display:flex;align-items:center;gap:14px;width:100%">
        <div class="icon">📁</div>
        <div style="flex:1">
          <div class="fname">hasnain,s future</div>
          <div class="fmeta">open to reveal a vibe — animation: hopeful glow</div>
        </div>
      </div>
    </article>
  </main>

  <!-- Overlay modal shown when user opens a folder -->
  <div class="overlay" id="overlay" aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-head">
        <div class="modal-title">
          <div class="micon">📂</div>
          <div>
            <div id="modalTitle" style="font-weight:800;font-size:18px">Opening...</div>
            <div style="font-size:13px;opacity:.7">Hasnain World — folder preview</div>
          </div>
        </div>
        <button class="close-btn" id="closeBtn" aria-label="Close">✕</button>
      </div>
      <div class="modal-body" id="modalBody">
        <div id="vibeText" class="vibe">Loading...</div>
      </div>
    </div>
  </div>

  <script>
    // JS to handle opening folders with different animations and messages
    const folders = document.querySelectorAll('.folder');
    const overlay = document.getElementById('overlay');
    const modalTitle = document.getElementById('modalTitle');
    const vibeText = document.getElementById('vibeText');
    const closeBtn = document.getElementById('closeBtn');

    const DATA = {
      old: {
        title: "hasnain,s old",
        vibe: "[hyderabad vibes]",
        accent: 'accent-old',
        revealDelay: 450
      },
      now: {
        title: "hasnain,s now",
        vibe: "[islamabad vibes]",
        accent: 'accent-now',
        revealDelay: 350
      },
      future: {
        title: "hasnain,s future",
        vibe: "[inshallah software engineer]",
        accent: 'accent-future',
        revealDelay: 300
      }
    };

    function openFolder(key){
      const data = DATA[key];
      if(!data) return;
      // set accent
      const modal = overlay.querySelector('.modal');
      modal.classList.remove('accent-old','accent-now','accent-future');
      modal.classList.add(data.accent);

      // set title and animated reveal text
      modalTitle.textContent = data.title;
      vibeText.textContent = '';
      overlay.classList.add('show');
      overlay.setAttribute('aria-hidden','false');

      // small timed reveal to mimic typing effect
      const reveal = data.vibe;
      let i = 0;
      vibeText.style.animation = 'none';
      // force reflow to restart CSS animation
      void vibeText.offsetWidth;

      // type characters one-by-one for a stronger effect (JS-driven), then add CSS blink
      function type(){
        if(i <= reveal.length){
          vibeText.textContent = reveal.slice(0,i);
          i++;
          setTimeout(type, 45);
        } else {
          // after typing finish, give a subtle blink effect using CSS
          vibeText.style.animation = 'blink .9s step-end 3';
        }
      }
      setTimeout(type, data.revealDelay);

      // trap focus briefly (basic)
      closeBtn.focus();
    }

    folders.forEach(f => {
      const key = f.dataset.key;
      f.addEventListener('click', ()=> openFolder(key));
      f.addEventListener('keypress', (e)=>{ if(e.key === 'Enter') openFolder(key); });
    });

    function closeOverlay(){
      overlay.classList.remove('show');
      overlay.setAttribute('aria-hidden','true');
      // return focus to first folder
      folders[0].focus();
    }
    closeBtn.addEventListener('click', closeOverlay);
    overlay.addEventListener('click', (e)=>{ if(e.target === overlay) closeOverlay(); });
    document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeOverlay(); });

    // Small accessibility: visually highlight folder on focus
    folders.forEach(f=>{
      f.addEventListener('focus', ()=> f.style.boxShadow = '0 18px 40px rgba(0,0,0,.6)');
      f.addEventListener('blur', ()=> f.style.boxShadow = '');
    });

    // Make icons yellow (explicit) to match requirement that folders show yellow color
    document.querySelectorAll('.icon').forEach(ic => ic.style.background = '#ffe66d');
  </script>
</body>
</html>

